{
  "title": "Phase Envelope",
  "description": "The typed JSON envelope a phase of the deterministic graph emits (docs/reorientation/02-architecture.md §3). One envelope per finished phase, written by the agent as data, validated by the graph's code before it feeds the next phase. Strict: an unknown field rejects the envelope.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "envelope": {
      "title": "Envelope",
      "description": "Contract version.",
      "type": "string",
      "enum": ["essaim/1"]
    },
    "run_id": {
      "title": "Run Id",
      "type": "string",
      "minLength": 1
    },
    "phase_id": {
      "title": "Phase Id",
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "title": "Lane",
      "description": "agent: a harness bounded to its write_scope; engineer: a human phase (the envelope carries the signed verdict, not code); code: a known command, the envelope is generated by the script.",
      "type": "string",
      "enum": ["agent", "engineer", "code"]
    },
    "agent": {
      "title": "Agent",
      "description": "Roster name, never a model id.",
      "type": "string",
      "minLength": 1
    },
    "status": {
      "title": "Status",
      "type": "string",
      "enum": ["done", "needs_retry", "blocked", "failed"]
    },
    "summary": {
      "title": "Summary",
      "description": "Short, human.",
      "type": "string"
    },
    "artifacts": {
      "title": "Artifacts",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string"},
          "kind": {"type": "string", "enum": ["file", "diff", "report"]}
        },
        "required": ["path", "sha256", "kind"]
      }
    },
    "changed_files": {
      "title": "Changed Files",
      "type": "array",
      "items": {"type": "string"}
    },
    "write_scope": {
      "title": "Write Scope",
      "description": "Globs the phase was bounded to.",
      "type": "array",
      "items": {"type": "string"}
    },
    "notes_for_next_agent": {
      "title": "Notes For Next Agent",
      "type": "string"
    },
    "commit_message": {
      "title": "Commit Message",
      "description": "Proposed by the agent, applied by code alone.",
      "type": "string"
    },
    "gate_results": {
      "title": "Gate Results",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gate": {"type": "string", "minLength": 1},
          "ok": {"type": "boolean"},
          "detail": {"type": "string"}
        },
        "required": ["gate", "ok", "detail"]
      }
    },
    "trace_cursor": {
      "title": "Trace Cursor",
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "envelope",
    "run_id",
    "phase_id",
    "lane",
    "agent",
    "status",
    "summary",
    "artifacts",
    "changed_files",
    "write_scope",
    "notes_for_next_agent",
    "commit_message",
    "gate_results",
    "trace_cursor"
  ]
}
